# TH8 - mau bien moi truong cho Docker Compose.
# Copy file nay thanh .env roi dien gia tri that. .env da nam trong .gitignore.

# ---------- Database (Supabase managed Postgres) ----------
# Bo trong DB_URL de dung gia tri mac dinh trong application.properties.
# DB_URL=jdbc:postgresql://<host>:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<mat-khau-db>

# ---------- Secret dung chung giua cac service ----------
# USER_SERVICE_INTERNAL_API_KEY: PHAI giong nhau o user-service, movie-service,
# booking-service va auth-service.
USER_SERVICE_INTERNAL_API_KEY=<chuoi-ngau-nhien>
# Tuy chon: dat rieng key cho movie-service. Bo trong thi dung chung key tren.
MOVIE_SERVICE_INTERNAL_API_KEY=
# JWT_SECRET: bat buoc cho auth-service, base64 toi thieu 32 byte.
JWT_SECRET=<base64-32-byte>

# ---------- payment-service ----------
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNP_TMN_CODE=
VNP_HASH_SECRET=
BANK_ID=
ACCOUNT_NO=
ACCOUNT_NAME=

# ---------- movie-service (tuy chon, thieu thi khong co diem/review TMDB) ----------
TMDB_TOKEN=
